# CloudSentinel Threat Intelligence

# AlienVault OTX API key.
# Get your personal key from your OTX account.
OTX_API_KEY=

# Optional: override the OTX API base URL.
# OTX_BASE_URL=https://otx.alienvault.com


# Required for authenticated dashboard access.
# Replace placeholders before starting the application.
CLOUDSENTINEL_USERNAME=CHANGE_ME
CLOUDSENTINEL_PASSWORD_HASH=
CLOUDSENTINEL_SECRET_KEY=

# Set true when serving over HTTPS; false is for local HTTP testing.
CLOUDSENTINEL_COOKIE_SECURE=false
